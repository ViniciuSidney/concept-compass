{
  "name": "organizador-de-conteudos",
  "version": "0.0.0-development",
  "private": true,
  "description": "Aplicação web local para organizar estudos em Matérias, Temas e Assuntos.",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "verify:m2": "node scripts/verify-m2.mjs",
