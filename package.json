    "verify:m5": "node scripts/verify-m5.mjs",
    "verify:m6": "node scripts/verify-m6.mjs",
    "verify:m7": "node scripts/verify-m7.mjs",
    "verify:m8": "node scripts/verify-m8.mjs",
    "verify:m8-1": "node scripts/verify-m8-1.mjs",
    "verify:m8-1-1": "node scripts/verify-m8-1-1.mjs",
    "verify:m9": "node scripts/verify-m9.mjs",
    "verify:m10": "node scripts/verify-m10.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "10.7.0",
    "prettier": "3.9.6"
  }
}
